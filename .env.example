# Set these in your shell / hosting environment (the server reads process.env)
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED in production
REQUIRE_BRACU_EMAIL=true                       # set to false to allow any email while testing
CLIENT_ORIGIN=http://localhost:5173            # only needed if the frontend is hosted separately
ADMIN_EMAIL=admin@bracu.ac.bd                  # used by `npm run seed`
ADMIN_PASSWORD=change-me-now
